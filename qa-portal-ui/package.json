{
  "name": "@am/qa-portal-ui",
  "version": "0.1.0",
  "private": true,
  "description": "QA operator portal (Flutter web) — npm wrappers for build & run",
  "scripts": {
    "get": "flutter pub get",
    "analyze": "flutter analyze --no-fatal-infos",
    "test": "flutter test",
    "run": "npm run run:local",
    "run:local": "flutter run -d chrome --web-port=8151 --dart-define=API_BASE=http://localhost:8150",
    "run:dev": "flutter run -d chrome --web-port=8151 --dart-define=API_BASE=https://am-dev.asrax.in/spt-poc --dart-define=ROOT_PATH=/spt-poc",
    "run:cluster": "flutter run -d chrome --web-port=8151 --dart-define=API_BASE=https://am.asrax.in/spt-poc --dart-define=ROOT_PATH=/spt-poc",
    "build": "npm run build:local",
    "build:local": "flutter build web --release --base-href=/ui/",
    "build:cluster": "flutter build web --release --base-href=/spt-poc/ui/ --dart-define=API_BASE=/spt-poc --dart-define=ROOT_PATH=/spt-poc",
    "clean": "flutter clean"
  }
}
