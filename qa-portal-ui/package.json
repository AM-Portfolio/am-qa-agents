{
  "name": "@am/qa-portal-ui",
  "version": "0.1.0",
  "private": true,
  "description": "QA operator portal (Flutter web + Windows) — npm wrappers for build & run",
  "scripts": {
    "get": "flutter pub get",
    "analyze": "flutter analyze --no-fatal-infos",
    "test": "flutter test",
    "run": "npm run run:chrome:local",
    "run:local": "flutter run -d web-server --web-hostname=127.0.0.1 --web-port=8151 --dart-define=API_BASE=http://localhost:8150",
    "run:chrome:local": "flutter run -d chrome --web-port=8151 --dart-define=API_BASE=http://localhost:8150",
    "run:dev": "flutter run -d chrome --web-port=8151 --dart-define=API_BASE=https://am-dev.asrax.in/qa --dart-define=ROOT_PATH=/qa",
    "run:chrome:dev": "npm run run:dev",
    "run:cluster": "flutter run -d chrome --web-port=8151 --dart-define=API_BASE=https://am.asrax.in/qa --dart-define=ROOT_PATH=/qa",
    "run:windows": "flutter run -d windows --dart-define=API_BASE=http://localhost:8150",
    "run:windows:local": "npm run run:windows",
    "run:windows:preprod": "flutter run -d windows --dart-define=API_BASE=https://am-preprod.asrax.in/qa --dart-define=ROOT_PATH=/qa",
    "run:windows:dev": "flutter run -d windows --dart-define=API_BASE=https://am-dev.asrax.in/qa --dart-define=ROOT_PATH=/qa",
    "build": "npm run build:local",
    "build:local": "flutter build web --release --base-href=/ui/",
    "build:dev": "flutter build web --release --base-href=/qa/ui/ --dart-define=API_BASE=/qa --dart-define=ROOT_PATH=/qa --no-wasm-dry-run",
    "build:cluster": "flutter build web --release --base-href=/qa/ui/ --dart-define=API_BASE=/qa --dart-define=ROOT_PATH=/qa --no-wasm-dry-run",
    "build:windows": "flutter build windows --release --dart-define=API_BASE=https://am-preprod.asrax.in/qa --dart-define=ROOT_PATH=/qa",
    "build:windows:local": "flutter build windows --release --dart-define=API_BASE=http://localhost:8150",
    "pack:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-windows.ps1",
    "clean": "flutter clean"
  }
}
