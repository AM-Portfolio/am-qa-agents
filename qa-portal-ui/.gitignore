/download/desktop/*.exe
/download/desktop/*.nupkg
/download/desktop/*.zip

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Windows Flutter engine artifacts
windows/flutter/ephemeral/

