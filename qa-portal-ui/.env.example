# Flutter portal — documentation for dart-defines / local run.
# Prefer npm scripts in package.json (they pass --dart-define).
# Dig-specific checked-in values: .env.dev  →  npm run run:dev / build:dev

# Local backend (web + Windows)
# API_BASE=http://localhost:8150
# ROOT_PATH=

# Dig Contabo (see .env.dev)
# API_BASE=https://am-dev.asrax.in/qa
# ROOT_PATH=/qa

# Preprod (default Windows release build)
# API_BASE=https://am-preprod.asrax.in/qa
# ROOT_PATH=/qa

# Prod cluster
# API_BASE=https://am.asrax.in/qa
# ROOT_PATH=/qa

# Velopack update feed (Windows packaged builds)
# VELOPACK_URL=https://github.com/AM-Portfolio/am-qa-agents/releases/latest/download
