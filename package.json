{
  "name": "am-qa-agents",
  "version": "0.2.1",
  "private": true,
  "description": "Monorepo wrappers — backend API + Flutter portal + smoke/tests + release report",
  "scripts": {
    "backend:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
    "backend:import": "python scripts/with_pythonpath.py python -c \"from composition.app import app; print(getattr(app,'title','ok'), len(app.routes))\"",
    "api:smoke": "python scripts/smoke_api.py",
    "agent:test": "python scripts/with_pythonpath.py pytest -q qa-agent/specs/tests/test_env_urls.py qa-agent/release_gate/tests/test_trigger_policy.py qa-agent/ui_evidence/tests/test_env_urls.py qa-agent/specs/tests/test_store_and_api.py qa-agent/release_gate/tests/test_stability_score.py qa-agent/release_gate/tests/test_release_catalogs.py qa-agent/release_gate/tests/test_asrax_release_ops.py qa-agent/release_gate/tests/test_cliq_release_gate.py",
    "vps:forward": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vps-port-forward.ps1",
    "vps:forward:qdrant": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vps-port-forward.ps1 -IncludeQdrant",
    "ui:get": "npm --prefix qa-portal-ui run get",
    "ui:analyze": "npm --prefix qa-portal-ui run analyze",
    "ui:test": "npm --prefix qa-portal-ui run test",
    "ui:start": "npm --prefix qa-portal-ui run run:local",
    "ui:start:dev": "npm --prefix qa-portal-ui run run:dev",
    "ui:start:cluster": "npm --prefix qa-portal-ui run run:cluster",
    "ui:build": "npm --prefix qa-portal-ui run build:local",
    "ui:build:cluster": "npm --prefix qa-portal-ui run build:cluster",
    "release:report": "python scripts/with_pythonpath.py python qa-agent/scripts/release_report.py",
    "release:report:prod": "npm run release:report -- --env prod --suite prod_ui_full --url https://am.asrax.in --login-mode credentials",
    "release:final": "python scripts/with_pythonpath.py python qa-agent/scripts/release_final_run.py",
    "release:final:prod": "npm run release:final -- --env prod --soak-min 30",
    "release:all:prod": "npm run release:report:prod && npm run release:final:prod",
    "release:sheet": "python ../am-infra/scripts/am-refresh-r01-services.py",
    "release:ops": "python scripts/with_pythonpath.py python qa-agent/scripts/start_release_ops_workflow.py",
    "release:ops:inline": "npm run release:ops -- --inline --skip-ui --skip-soak --skip-sheet --skip-drive --skip-cliq --fixtures --soak-min 0",
    "release:ops:prod": "npm run release:ops -- --env prod --suite prod_ui_full --url https://am.asrax.in --login-mode credentials --soak-min 30",
    "release:request": "python scripts/with_pythonpath.py python qa-agent/scripts/request_release_ops.py",
    "release:request:prod": "npm run release:request -- --env prod --suite prod_ui_full --url https://am.asrax.in --soak-min 30",
    "test:flow": "npm run api:smoke && npm run agent:test",
    "test": "npm run test:flow",
    "start": "npm run backend:start",
    "dev:ui": "npm run ui:start",
    "build": "npm run ui:build:cluster",
    "ci": "npm run agent:test"
  }
}
