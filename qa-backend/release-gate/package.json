{
  "name": "@am/qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "qa-agent — commit-driven release readiness orchestrator",
  "scripts": {
    "setup": "python -m pip install -e \".[dev,temporal]\"",
    "setup:all": "python -m pip install -e \".[all]\"",
    "gateway": "python -m am_qa_agent.gateway",
    "worker": "python -m am_qa_agent.orchestrator",
    "dev": "npm run gateway",
    "start": "npm run gateway",
    "start:gateway": "npm run gateway",
    "start:worker": "npm run worker",
    "start:all": "node scripts/run-both.js",
    "test": "python -m pytest tests -q",
    "test:verbose": "python -m pytest tests -v",
    "health": "python scripts/healthcheck.py",
    "smoke": "python scripts/smoke_release.py",
    "pilot:local": "python scripts/pilot_local_flow.py",
    "smoke:ci": "python -c \"import os; os.environ.setdefault('QA_AGENT_SMOKE_TRIGGER','ci_master_merge'); os.environ.setdefault('QA_AGENT_SMOKE_SERVICE','am-analysis'); import runpy; runpy.run_path('scripts/smoke_release.py', run_name='__main__')\"",
    "postman:sync": "python scripts/sync_postman_collection.py",
    "release:start": "python scripts/smoke_release.py",
    "release:approve": "python scripts/hitl_signal.py approve",
    "release:reject": "python scripts/hitl_signal.py reject",
    "logs:clean": "node scripts/clean-artifacts.js"
  }
}
