# Heavy runtime for am-ui-test-agent — rebuild when this file or
# qa-backend/ui-evidence/requirements.txt changes. Build from monorepo root.
# Keep base tag aligned with playwright== in requirements.txt.
FROM mcr.microsoft.com/playwright/python:v1.60.0-jammy

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    APP_PORT=8130 \
    TZ=Asia/Kolkata \
    HEADLESS=true

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY qa-backend/ui-evidence/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
