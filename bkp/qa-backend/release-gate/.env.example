# qa-agent — copy to `.env` and fill from am-agents/.env (gitignored)
# cp .env.example .env

AM_AGENTS_ENV_FILE=F:/am-repos/am-repos/am-agents/.env

# Gateway
QA_AGENT_ENV=local
QA_AGENT_HOST=0.0.0.0
QA_AGENT_PORT=8150
QA_AGENT_GATEWAY_TOKEN=dev-token-change-me

# Temporal
# UI (browser traces): https://temporal.asrax.in  — HTTP only, not for SDK
# SDK / worker host: gRPC. From laptop use port-forward OR run in-cluster.
#   port-forward: kubectl -n temporal port-forward svc/temporal-frontend 7233:7233
#   in-cluster:   temporal-frontend.temporal.svc.cluster.local:7233
# Do NOT set TEMPORAL_HOST=temporal.asrax.in — that host is the Web UI, not gRPC.
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=qa-agent
TEMPORAL_TASK_QUEUE=qa-agent-release-v1
TEMPORAL_UI_EXTERNAL_URL=https://temporal.asrax.in

# Specialists (public domains — no port-forward for tool-agent / GNX)
FIN_AGENT_BASE_URL=http://127.0.0.1:8100
UI_TEST_AGENT_BASE_URL=http://127.0.0.1:8130
TOOL_AGENT_BASE_URL=https://am-dev.asrax.in/tools
TOOL_AGENT_URL=https://am-dev.asrax.in/tools
GNX_MCP_URL=https://gitnexus.asrax.in
# CODE_INTELLIGENCE_INDEX_URL=

# Store
QA_AGENT_STORE=sqlite
QA_AGENT_SQLITE_PATH=artifacts/qa-agent.db
QA_AGENT_DATABASE_URL=postgresql://agent_platform:CHANGEME@localhost:5432/agent_platform
QA_AGENT_ARTIFACT_DIR=artifacts/pdf

# LiteLLM + Langfuse (from am-agents)
QA_AGENT_LLM_ENABLED=true
QA_AGENT_LLM_MAX_CALLS=3
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=CHANGEME
OPENAI_API_KEY=CHANGEME
OPENAI_BASE_URL=http://localhost:4000
LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
QA_AGENT_LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://langfuse.example
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME

# Cliq
ZOHO_CLIQ_WEBHOOK_URL=https://cliq.zoho.in/api/v2/channelsbyname/CHANNEL/message?zapikey=CHANGEME
QA_AGENT_CLIQ_WEBHOOK_URL=
QA_AGENT_CLIQ_CHANNEL=qa-agent

# OpenProject
OPENPROJECT_URL=https://openproject.example
OPENPROJECT_API_TOKEN=CHANGEME
OPENPROJECT_PROJECT_ID=3
OPENPROJECT_TYPE_ID=1
OPENPROJECT_DEFAULT_ASSIGNEE_ID=5
QA_AGENT_OP_PROJECT=3

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGEME
MINIO_BUCKET=agent-docs
QA_AGENT_PDF_STORE=document.store

# Observe
PROMETHEUS_URL=http://localhost:9090/prometheus
GRAFANA_EXTERNAL_URL=https://grafana.example

# GrowthBook
GROWTHBOOK_API_HOST=https://growthbook.example/gbapi
GROWTHBOOK_CLIENT_KEY=sdk-CHANGEME

# GitHub
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=

# Smoke / matrix
QA_AGENT_SMOKE_TARGET_URL=http://127.0.0.1:3000
QA_AGENT_SMOKE_PROFILE=SMOKE
QA_AGENT_MATRIX_TIERS=P0,P1

# Local toggles (true = safe first boot without all specialists)
QA_AGENT_SKIP_UI_TEST=true
QA_AGENT_SKIP_NOTIFY=false
QA_AGENT_SKIP_INDEX_AWAIT=true
QA_AGENT_SKIP_FIN_AGENT=true
QA_AGENT_SKIP_OBSERVE=true
QA_AGENT_SKIP_WORK_ITEM=false
QA_AGENT_SKIP_SAST=false
QA_AGENT_SKIP_GITHUB_CHECKS=true
QA_AGENT_SKIP_GROWTHBOOK=true
QA_AGENT_SKIP_DOCUMENT_STORE=true
QA_AGENT_HITL_AUTO_APPROVE=true
QA_AGENT_HITL_TIMEOUT_SECONDS=30
QA_AGENT_HITL_RBAC=false
