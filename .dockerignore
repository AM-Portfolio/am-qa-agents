# Keep secrets and local junk out of the am-qa-agents image
**/.env
**/.env.*
!**/.env.example
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/node_modules/
**/.git/
**/data/
**/artifacts/
**/logs/
**/*.log
qa-agent/vendor/wheels/
qa-portal-ui/.dart_tool/
# Keep build/web for Specs Flutter portal; drop Flutter compile intermediates
qa-portal-ui/build/**
!qa-portal-ui/build/web/
!qa-portal-ui/build/web/**
