# Local unified qa-agent — copy to qa-agent/.env and fill real values.
# Prefer values from am-agents/poc/spt/.env + am-agents/.env for lab credentials.
#
# PowerShell:
#   $env:PYTHONPATH = "$(Get-Location)\qa-agent;$(Get-Location)\qa-agent\release_gate"
#   python -m composition.main

APP_PORT=8150
QA_AGENT_PORT=8150
QA_AGENT_COLOCATED=1
QA_AGENT_WORKER_ENABLED=0
ROOT_PATH=
LOG_LEVEL=INFO
APP_ENV=dev
DEFAULT_ENVIRONMENT=dev
DEFAULT_RUN_PROFILE=debug

# Data (local)
DATA_DIR=./data
REPORT_DIR=./data/reports/ui-test
SPT_STORE=db
# SPT_DATABASE_URL=postgresql+psycopg://spt:spt@localhost:5432/spt

# Catalog — mount or local dir of spt.yaml files (product + self registrations)
# SPT_CATALOG_EXTERNAL=./catalog-external

# Public / auth (optional overrides)
SPT_PUBLIC_BASE_URL=http://localhost:8150
# POC_TARGET_URL=
# SPT_IDENTITY_URL=
SPT_AUTH_USERNAME=
SPT_AUTH_PASSWORD=
SPT_USER_ID=
SPT_DEFAULT_SERVICE=
SPT_ACL_REQUIRED=false
# SPT_BOOTSTRAP_KEYS=developer:local-dev:spt_sk_dev_localchange_me

# Colocated loopback (same process) — or point at VPS Playwright agent:
SPT_UI_TEST_AGENT_URL=http://127.0.0.1:8150
UI_TEST_AGENT_URL=http://127.0.0.1:8150
UI_TEST_AGENT_BASE_URL=http://127.0.0.1:8150
# SPT_UI_TEST_AGENT_URL=https://am-dev.asrax.in/ui-test
# UI_TEST_AGENT_URL=https://am-dev.asrax.in/ui-test
# UI_TEST_AGENT_BASE_URL=https://am-dev.asrax.in/ui-test
SPT_UI_TEST_DEFAULT_PROFILE=AUTH_FLOW_MAIN

# Specialists / GitNexus (cluster DNS or public)
FIN_AGENT_BASE_URL=https://am-dev.asrax.in/fin-agent
TOOL_AGENT_BASE_URL=https://am-dev.asrax.in/tools
GNX_MCP_URL=https://gitnexus.asrax.in
# CODE_INTELLIGENCE_INDEX_URL=

# Temporal — use npm run vps:forward (VPS kubeconfig), then set worker=1 for release-readiness
TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_NAMESPACE=qa-agent
TEMPORAL_TASK_QUEUE=qa-agent-release-v1

# SPT / API load defaults for release-gate (50 requests per payload API)
QA_AGENT_API_LOAD_VUS=1
QA_AGENT_API_LOAD_ITERATIONS=50
QA_AGENT_SPT_VUS=1
QA_AGENT_SPT_ITERATIONS=50
QA_AGENT_UI_ONLY_SERVICES=am-modern-ui
QA_AGENT_CATALOG_READY_TIMEOUT_SEC=180

# Qdrant — local PF after VPS STS is scaled up (often replicas=0 → memory bypassed)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_HTTPS=false
# QDRANT_API_KEY=

# k6
# Windows: path to k6.exe — Linux: /usr/local/bin/k6
K6_BIN=k6

# Observability / artifacts — Influx via vps:forward (not public HTTPS; Authentik-gated)
GRAFANA_PUBLIC_URL=https://grafana.asrax.in
GRAFANA_K6_DASHBOARD_UID=spt-load-testing
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_ORG=am-portfolio
INFLUXDB_BUCKET=load-testing-dev
INFLUXDB_TOKEN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Portal Flutter (optional — serve build/web from specs)
SPT_PORTAL_FLUTTER=false
# SPT_PORTAL_FLUTTER_DIR=../qa-portal-ui/build/web

# LLM for ui_evidence (off by default)
QA_AGENT_LLM_ENABLED=false
LLM_ROUTING=gateway
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
HEADLESS=true

# Vault-backed in cluster — local placeholders only
QA_AGENT_GATEWAY_TOKEN=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Cliq release gate (single admin must approve before AsraxReleaseOpsWorkflow starts)
# QA_AGENT_RELEASE_ADMIN=you@company.com
# QA_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8150
# QA_AGENT_CLIQ_WEBHOOK_URL=
# QA_AGENT_CLIQ_RELEASE_WEBHOOK_URL=
# QA_AGENT_CLIQ_RELEASE_SECRET=
# QA_AGENT_CLIQ_INBOUND_TOKEN=
