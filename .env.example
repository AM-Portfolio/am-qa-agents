# am-qa-agents monorepo — copy pieces into qa-agent/.env and use portal npm scripts.
# Never commit real .env files.

# Prod UI Playwright (npm run ui -- auth|portfolio|prod)
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# TEST_ENVIRONMENT=prod
# TEST_PORTFOLIO_ID=   # optional; null/empty -> list/legacy routes still verified

# Backend (see qa-agent/.env.example)
# PYTHONPATH=<repo>/qa-agent;<repo>/qa-agent/release_gate

# Portal (see qa-portal-ui/.env.example + npm run run:local | run:cluster)
